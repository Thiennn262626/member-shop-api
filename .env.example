APP_ENV=development
PORT=8088

# MONGODB CONFIG
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=member-shop

# REDIS CONFIG
REDIS_ADDR=localhost:6379
REDIS_HOST=localhost:6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=

# JWT TOKEN SECRETS & ECDSA ES256
# Leave empty to let server auto-generate an ephemeral ECDSA P-256 key pair during development
JWT_ECDSA_PRIVATE_KEY=
JWT_ECDSA_PUBLIC_KEY=
JWT_SECRET_ACCESS=your_jwt_access_secret_key_here
JWT_SECRET_REFRESH=your_jwt_refresh_secret_key_here
ACCESS_TOKEN_EXPIRES=900
REFRESH_TOKEN_EXPIRES=604800

# RATE LIMITER
RATE_LIMITER_REQUEST_SEC=5
RATE_LIMITER_REQUEST_BURST=10
