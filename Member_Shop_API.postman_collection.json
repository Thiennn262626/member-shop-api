{
  "info": {
    "_postman_id": "8f3e5b61-9c87-41ab-8e0b-21d3f9b2d88c",
    "name": "Member Shop API (Bake & Sip)",
    "description": "Bộ sưu tập Postman hoàn chỉnh để kiểm thử toàn bộ hệ thống API Backend Member Shop (Bake & Sip).\n- Framework: Golang 1.24 + Gin-Gonic + MongoDB + SSE\n- Tự động lưu Bearer Token sau khi gọi API Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shiftId",
      "value": "",
      "type": "string"
    },
    {
      "key": "workShiftId",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "voucherId",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Staff",
      "item": [
        {
          "name": "1.1. Login (Admin / Thu Ngân)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.accessToken) {",
                  "        pm.collectionVariables.set(\"token\", json.accessToken);",
                  "        console.log(\"Saved JWT Access Token:\", json.accessToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Đăng nhập tài khoản bằng Username & mã PIN. Sau khi đăng nhập thành công, token sẽ tự động lưu vào biến {{token}}."
          }
        },
        {
          "name": "1.2. Get Current User Info (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "me"]
            },
            "description": "Lấy thông tin tài khoản đang đăng nhập từ JWT Token."
          }
        },
        {
          "name": "1.3. Get All Staff Accounts (Owner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/staff",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "staff"]
            },
            "description": "Chỉ dành cho Owner: Lấy danh sách toàn bộ tài khoản nhân viên."
          }
        },
        {
          "name": "1.4. Create New Staff Account (Owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"thungan1\",\n  \"name\": \"Trần Thị Thu Ngân\",\n  \"role\": \"cashier\",\n  \"phone\": \"0912345678\",\n  \"shift\": \"Ca Sáng (06:30 - 14:30)\",\n  \"hourlyRate\": 28000,\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/staff",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "staff"]
            }
          }
        },
        {
          "name": "1.5. Update Staff Account (Owner)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Trần Thị Thu Ngân (Cập nhật)\",\n  \"hourlyRate\": 30000,\n  \"phone\": \"0988776655\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/staff/{{staffId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "staff", "{{staffId}}"]
            }
          }
        },
        {
          "name": "1.6. Toggle Staff Active Status (Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/staff/{{staffId}}/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "staff", "{{staffId}}", "toggle"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Web Storefront (Public API)",
      "item": [
        {
          "name": "2.1. Get Storefront Menu Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/products?all=false",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products"],
              "query": [
                {
                  "key": "all",
                  "value": "false",
                  "description": "false: chỉ lấy món đang bật bán (isActive=true)"
                }
              ]
            },
            "description": "Lấy danh sách các món bánh & nước đang mở bán ngoài trang chủ."
          }
        },
        {
          "name": "2.2. Get Product Detail with Options",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "2.3. Get Shop Config & Delivery Policy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/config",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "config"]
            },
            "description": "Lấy thông tin tiệm, tỷ lệ đổi điểm, mốc tính ship đồng giá và tài khoản VietQR."
          }
        },
        {
          "name": "2.4. Validate Voucher Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"BAKESIP10\",\n  \"subTotal\": 150000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/vouchers/validate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "vouchers", "validate"]
            },
            "description": "Kiểm tra tính hợp lệ của mã giảm giá và tính toán số tiền giảm trực tiếp từ backend."
          }
        },
        {
          "name": "2.5. Lookup Membership Card by Phone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/customers/lookup?phone=0988111222",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "customers", "lookup"],
              "query": [
                {
                  "key": "phone",
                  "value": "0988111222"
                }
              ]
            },
            "description": "Khách hàng tra cứu điểm tích lũy, số điểm khả dụng, hạng thẻ và lịch sử giao dịch điểm."
          }
        },
        {
          "name": "2.6. Track Order Status (By Phone or Code)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/track?phone=0988111222",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders", "track"],
              "query": [
                {
                  "key": "phone",
                  "value": "0988111222"
                },
                {
                  "key": "code",
                  "value": "#BS-8924",
                  "disabled": true
                }
              ]
            },
            "description": "Theo dõi tiến độ đơn hàng thời gian thực (4 bước: Đơn tạm -> Đang làm bánh -> Đang giao -> Hoàn tất)."
          }
        },
        {
          "name": "2.7. Create Web Order (Khách Chốt Đơn)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.order && json.order.id) {",
                  "        pm.collectionVariables.set(\"orderId\", json.order.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Linh Chi\",\n  \"customerPhone\": \"0988111222\",\n  \"items\": [\n    {\n      \"productId\": \"672722b51234567890abcdef\",\n      \"productName\": \"Bánh Sừng Bò Trứng Muối Hoàng Kim\",\n      \"unitPrice\": 38000,\n      \"quantity\": 2,\n      \"optionsSummary\": \"Nóng giòn\",\n      \"itemNote\": \"Nướng xém cạnh giúp em\",\n      \"isRedeemedWithPoints\": false\n    },\n    {\n      \"productId\": \"672722b51234567890abcdeg\",\n      \"productName\": \"Bánh Tart Trứng Than Caramel\",\n      \"unitPrice\": 25000,\n      \"quantity\": 1,\n      \"isRedeemedWithPoints\": true,\n      \"pointsCost\": 25\n    }\n  ],\n  \"note\": \"Giao trước cổng toà nhà\",\n  \"fulfillmentType\": \"delivery\",\n  \"deliveryAddress\": \"123 Phan Xích Long, P.2, Phú Nhuận\",\n  \"deliveryTimeType\": \"asap\",\n  \"voucherCode\": \"BAKESIP10\",\n  \"discountPointsUsed\": 10,\n  \"totalPointsRedeemedItems\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders"]
            },
            "description": "Tạo đơn hàng tạm từ Web. Backend tự tính lại đơn giá, áp voucher, trừ điểm và tính ship an toàn."
          }
        }
      ]
    },
    {
      "name": "3. POS & Order Management",
      "item": [
        {
          "name": "3.1. Create POS Order (Bán Tại Quầy / Lên Đơn Giao)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Khách Vãng Lai\",\n  \"customerPhone\": \"0977333444\",\n  \"items\": [\n    {\n      \"productId\": \"672722b51234567890abcdef\",\n      \"productName\": \"Trà Sữa Ô Long Nướng Trân Châu Dẻo\",\n      \"unitPrice\": 39000,\n      \"quantity\": 2,\n      \"optionsSummary\": \"Size L • 50% Đường • Ít Đá\"\n    }\n  ],\n  \"paymentMethod\": \"cash\",\n  \"status\": \"completed\",\n  \"paymentStatus\": \"paid\",\n  \"fulfillmentType\": \"pickup\",\n  \"discountPointsUsed\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/pos/orders",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pos", "orders"]
            },
            "description": "Thu ngân lên đơn tại quầy POS. Khi status = completed & paid, hệ thống tự động tích điểm cho khách và ghi nhận vào ca trực."
          }
        },
        {
          "name": "3.2. Get Orders List (Admin/POS)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders?limit=20&offset=0&status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "status",
                  "value": "pending",
                  "description": "ALL, pending, confirmed, shipping, completed, cancelled"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "phone",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "3.3. Get Order Detail by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "3.4. Update Order Status & Shipper Info",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"paymentStatus\": \"paid\",\n  \"shipperInfo\": \"Anh Hùng Grab (0908123456)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders", "{{orderId}}", "status"]
            },
            "description": "Cập nhật tiến trình đơn: pending -> confirmed -> shipping -> completed. Khi sang completed, hệ thống tự động cộng điểm cho khách."
          }
        }
      ]
    },
    {
      "name": "4. Shifts & Cash Drawer (Giao Ca & Chốt Két)",
      "item": [
        {
          "name": "4.1. Get Current Open Shift",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/shifts/current",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "shifts", "current"]
            },
            "description": "Lấy thông tin ca làm việc hiện đang mở (quỹ đầu ca, tổng tiền mặt, QR, doanh thu)."
          }
        },
        {
          "name": "4.2. Open New Shift (Mở Ca / Nhập Tiền Lẻ Đầu Ca)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set(\"shiftId\", json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shiftName\": \"Ca Sáng (06:30 - 14:30)\",\n  \"initialFloat\": 500000,\n  \"notes\": \"Bỏ két 500k tiền thối lẻ đầu ca\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/shifts/open",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "shifts", "open"]
            }
          }
        },
        {
          "name": "4.3. Close Shift & Reconcile Cash (Chốt Két Kết Ca)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actualCash\": 2350000,\n  \"notes\": \"Bàn giao ca đầy đủ, tiền két khớp 100%\",\n  \"nextStaffName\": \"Lê Hoàng Yến (Ca Chiều)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/shifts/{{shiftId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "shifts", "{{shiftId}}", "close"]
            },
            "description": "Nhập số tiền mặt thực tế đếm được trong két. Hệ thống tự so sánh với expectedCash và tính difference thừa/thiếu."
          }
        },
        {
          "name": "4.4. Get Shift History (Owner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/shifts/history?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "shifts", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Work Shifts & Payroll (Lịch Làm & Bảng Lương)",
      "item": [
        {
          "name": "5.1. Get Work Shifts by Month (Lịch Ca)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/work-shifts?month=2026-03",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "work-shifts"],
              "query": [
                {
                  "key": "month",
                  "value": "2026-03"
                },
                {
                  "key": "staffId",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Load danh sách các ca làm việc trong tháng để vẽ lên tờ lịch làm việc."
          }
        },
        {
          "name": "5.2. Save Monthly Roster Schedule (Owner Phân Ca)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffId\": \"{{staffId}}\",\n  \"month\": \"2026-03\",\n  \"assignments\": [\n    {\n      \"date\": \"2026-03-26\",\n      \"shiftType\": \"morning\",\n      \"notes\": \"Trực quầy chính ca sáng\"\n    },\n    {\n      \"date\": \"2026-03-27\",\n      \"shiftType\": \"afternoon\",\n      \"notes\": \"Trực quầy chính ca chiều\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/work-shifts/roster",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "work-shifts", "roster"]
            }
          }
        },
        {
          "name": "5.3. Check-in Work Shift (Thu Ngân Điểm Danh)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/work-shifts/{{workShiftId}}/check-in",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "work-shifts", "{{workShiftId}}", "check-in"]
            }
          }
        },
        {
          "name": "5.4. Confirm Attendance & Actual Hours (Chốt Công Cuối Ngày)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actualHours\": 8.0,\n  \"status\": \"completed\",\n  \"notes\": \"Hoàn tất ca làm việc đầy đủ 8.0 giờ\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/work-shifts/{{workShiftId}}/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "work-shifts", "{{workShiftId}}", "attendance"]
            }
          }
        },
        {
          "name": "5.5. Get Monthly Payroll Summary (Owner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/payroll?month=2026-03",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "payroll"],
              "query": [
                {
                  "key": "month",
                  "value": "2026-03"
                }
              ]
            },
            "description": "Lấy bảng tổng hợp công, số giờ thực tế, lương theo giờ và thực nhận của toàn bộ nhân viên."
          }
        },
        {
          "name": "5.6. Adjust Payroll Allowance/Deduction (Owner Thưởng/Phạt)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
